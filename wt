#!/usr/bin/env bash
set -euo pipefail

print_help() {
    case "${1:-}" in
        new)
            echo "Usage: wt new <branch-name> [base-ref] [--no-cd]"
            echo ""
            echo "Create a worktree for a new or existing branch."
            echo "New branches start from the current worktree unless base-ref is provided."
            echo ""
            echo "Options:"
            echo "  --no-cd                       Do not cd into the worktree"
            ;;
        ls|list)
            echo "Usage: wt ls"
            echo ""
            echo "List all worktrees and their status."
            ;;
        done|rm|remove)
            echo "Usage: wt done [branch] [--force]"
            echo "       wt done --all [--force]"
            echo ""
            echo "Remove a worktree, refusing unsafe removals unless --force is used."
            ;;
        cd|path)
            echo "Usage: wt cd [name]"
            echo ""
            echo "Change to a worktree, or to the main checkout when no name is given."
            ;;
        *)
            echo "Usage: wt <command> [args]"
            echo ""
            echo "Commands:"
            echo "  new <branch> [base] [--no-cd]  Create worktree from the current branch and cd into it"
            echo "  ls                             List all worktrees with status"
            echo "  done [branch] [--force]        Remove worktree (default: current worktree)"
            echo "  done --all [--force]           Remove all worktrees (skips unsafe ones)"
            echo "  cd [name]                      Change to worktree (or main repo if no arg)"
            echo ""
            echo "Run 'wt <command> -h' for command-specific help."
            ;;
    esac
}

# Help should work from any directory and must never perform a command action.
if [[ "${1:-}" == "help" ]]; then
    print_help "${2:-}"
    exit 0
fi

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            if [[ "${1:-}" == "-h" ]] || [[ "${1:-}" == "--help" ]]; then
                print_help
            else
                print_help "${1:-}"
            fi
            exit 0
            ;;
    esac
done

# Find the main repo (where .git is a directory, not a file)
find_main_repo() {
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]]; then
            echo "$dir"
            return 0
        elif [[ -f "$dir/.git" ]]; then
            # This is a worktree, follow the gitdir to find main repo
            # gitdir format: gitdir: /path/to/main/.git/worktrees/branch-name
            local gitdir=$(cat "$dir/.git" | sed 's/gitdir: //')
            # Strip /worktrees/xxx to get main .git dir, then get parent
            local main_git="${gitdir%/worktrees/*}"
            dirname "$main_git"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    echo "Not in a git repository" >&2
    return 1
}

MAIN_REPO=$(find_main_repo)
REPO_NAME=$(basename "$MAIN_REPO")
CLAUDE_PROJECTS_DIR="$HOME/.claude/projects"

# Convert path to Claude project directory name (replaces / with -)
path_to_claude_project() {
    echo "$1" | sed 's|^/|-|; s|/|-|g'
}

# Sanitize branch name for use in directory paths (replaces / with -)
sanitize_branch() {
    echo "$1" | sed 's|/|-|g'
}

# Check if worktree has uncommitted changes
has_uncommitted_changes() {
    local wt_path="$1"
    ! git -C "$wt_path" diff --quiet HEAD 2>/dev/null || \
    ! git -C "$wt_path" diff --cached --quiet HEAD 2>/dev/null || \
    [[ -n "$(git -C "$wt_path" ls-files --others --exclude-standard)" ]]
}

# Check if worktree has unpushed commits
has_unpushed_commits() {
    local wt_path="$1"
    local branch=$(git -C "$wt_path" rev-parse --abbrev-ref HEAD)
    local upstream=$(git -C "$wt_path" rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo "")

    if [[ -z "$upstream" ]]; then
        # No upstream set - check if branch exists on origin
        if git -C "$wt_path" show-ref --verify --quiet "refs/remotes/origin/$branch" 2>/dev/null; then
            # Remote branch exists, compare
            [[ -n "$(git -C "$wt_path" log "origin/$branch..HEAD" --oneline 2>/dev/null)" ]]
        else
            # No remote branch - consider unpushed if there are commits
            return 0
        fi
    else
        [[ -n "$(git -C "$wt_path" log "$upstream..HEAD" --oneline 2>/dev/null)" ]]
    fi
}

# Remove a single worktree with safety checks
# Returns the worktree path on success (for shell wrapper to detect)
remove_worktree() {
    local worktree_path="$1"
    local display_name="${2:-$(basename "$worktree_path" | sed "s/^${REPO_NAME}-//")}"

    if [[ ! -d "$worktree_path" ]]; then
        echo "Worktree not found: $worktree_path" >&2
        return 1
    fi

    # Safety checks
    if has_uncommitted_changes "$worktree_path"; then
        echo "ERROR: Worktree '$display_name' has uncommitted changes" >&2
        echo "  Commit or stash changes before removing" >&2
        return 1
    fi

    if has_unpushed_commits "$worktree_path"; then
        echo "ERROR: Worktree '$display_name' has unpushed commits" >&2
        echo "  Push changes before removing" >&2
        return 1
    fi

    local actual_branch
    actual_branch=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$display_name")

    # Remove symlinks first (git worktree remove doesn't like symlinks)
    rm -f "$worktree_path/.claude"

    # Remove Claude projects symlink
    wt_project=$(path_to_claude_project "$worktree_path")
    if [[ -L "$CLAUDE_PROJECTS_DIR/$wt_project" ]]; then
        rm -f "$CLAUDE_PROJECTS_DIR/$wt_project"
    fi

    git -C "$MAIN_REPO" worktree remove "$worktree_path"
    echo "Removed worktree: $worktree_path"
    echo "Branch '$actual_branch' preserved"
    # Signal to shell wrapper which worktree was removed
    echo "__WT_REMOVED__:$worktree_path"
}

# Force-remove a single worktree (warns and prompts for confirmation)
# All user-facing output goes to /dev/tty since the shell wrapper captures stdout+stderr
force_remove_worktree() {
    local worktree_path="$1"
    local display_name="${2:-$(basename "$worktree_path" | sed "s/^${REPO_NAME}-//")}"

    if [[ ! -d "$worktree_path" ]]; then
        echo "Worktree not found: $worktree_path" >/dev/tty
        return 1
    fi

    # Show warnings
    local warnings=""
    if has_uncommitted_changes "$worktree_path"; then
        warnings="uncommitted changes"
    fi
    if has_unpushed_commits "$worktree_path"; then
        [[ -n "$warnings" ]] && warnings="$warnings, "
        warnings="${warnings}unpushed commits"
    fi

    if [[ -n "$warnings" ]]; then
        echo "WARNING: Worktree '$display_name' has $warnings" >/dev/tty
    fi

    # Prompt for confirmation (read from /dev/tty for --all mode where stdin is consumed)
    local confirm
    echo -n "Remove worktree '$display_name'? [y/N] " >/dev/tty
    read -r confirm </dev/tty
    if [[ "$confirm" != [yY] ]]; then
        echo "Skipped $display_name" >/dev/tty
        return 1
    fi

    local actual_branch
    actual_branch=$(git -C "$worktree_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$display_name")

    # Remove symlinks first (git worktree remove doesn't like symlinks)
    rm -f "$worktree_path/.claude"

    # Remove Claude projects symlink
    wt_project=$(path_to_claude_project "$worktree_path")
    if [[ -L "$CLAUDE_PROJECTS_DIR/$wt_project" ]]; then
        rm -f "$CLAUDE_PROJECTS_DIR/$wt_project"
    fi

    git -C "$MAIN_REPO" worktree remove --force "$worktree_path"
    echo "Removed worktree: $worktree_path"
    echo "Branch '$actual_branch' preserved"
    echo "__WT_REMOVED__:$worktree_path"
}

case "${1:-}" in
    new)
        shift
        no_cd=false
        branch=""
        base=""

        # Parse arguments
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --no-cd)
                    no_cd=true
                    shift
                    ;;
                *)
                    if [[ -z "$branch" ]]; then
                        branch="$1"
                    else
                        base="$1"
                    fi
                    shift
                    ;;
            esac
        done

        if [[ -z "$branch" ]]; then
            echo "Usage: wt new <branch-name> [base-ref] [--no-cd]" >&2
            exit 1
        fi

        if [[ -z "$base" ]]; then
            base="HEAD"
            base_display=$(git -C "$PWD" symbolic-ref --quiet --short HEAD 2>/dev/null || git -C "$PWD" rev-parse --short HEAD)
        else
            base_display="$base"
        fi

        worktree_path="$(dirname "$MAIN_REPO")/${REPO_NAME}-$(sanitize_branch "$branch")"

        # Check if branch already exists
        if git -C "$MAIN_REPO" show-ref --verify --quiet "refs/heads/$branch"; then
            echo "Branch '$branch' exists, creating worktree for it..."
            git -C "$MAIN_REPO" worktree add "$worktree_path" "$branch"
        else
            echo "Creating new branch '$branch' from '$base_display'..."
            git -C "$PWD" worktree add -b "$branch" "$worktree_path" "$base"
        fi

        # Symlink .claude directory for settings
        if [[ -d "$MAIN_REPO/.claude" ]]; then
            ln -s "$MAIN_REPO/.claude" "$worktree_path/.claude"
            echo "Linked .claude/ to main repo"
        fi

        # Symlink Claude projects directory so conversations are shared
        main_project=$(path_to_claude_project "$MAIN_REPO")
        wt_project=$(path_to_claude_project "$worktree_path")
        if [[ -d "$CLAUDE_PROJECTS_DIR/$main_project" ]] && [[ ! -e "$CLAUDE_PROJECTS_DIR/$wt_project" ]]; then
            ln -s -- "$main_project" "$CLAUDE_PROJECTS_DIR/$wt_project"
            echo "Linked Claude conversations to main repo"
        fi

        # Copy .env from current repo if it exists
        if [[ -f "$PWD/.env" ]]; then
            cp "$PWD/.env" "$worktree_path/.env"
            echo "Copied .env to new worktree"
        fi

        # Run setup.sh if it exists
        if [[ -x "$worktree_path/setup.sh" ]]; then
            echo "Running setup.sh..."
            (cd "$worktree_path" && ./setup.sh)
        fi

        echo ""
        echo "Created worktree: $worktree_path"

        # Signal to shell wrapper to cd (unless --no-cd)
        if [[ "$no_cd" == "false" ]]; then
            echo "__WT_CD__:$worktree_path"
        fi
        ;;

    ls|list)
        while IFS= read -r line; do
            wt_path=$(echo "$line" | awk '{print $1}')
            branch=$(echo "$line" | awk '{print $3}' | tr -d '[]')

            # Determine display name (show mismatch if branch differs from folder)
            if [[ "$wt_path" == "$MAIN_REPO" ]]; then
                display="[$branch]"
            else
                folder_name=$(basename "$wt_path" | sed "s/^${REPO_NAME}-//")
                if [[ "$folder_name" != "$branch" ]]; then
                    display="[$folder_name → $branch]"
                else
                    display="[$folder_name]"
                fi
            fi

            # Determine status
            status=""
            if [[ -d "$wt_path" ]]; then
                if has_uncommitted_changes "$wt_path" 2>/dev/null; then
                    status="*"
                fi
                if has_unpushed_commits "$wt_path" 2>/dev/null; then
                    status="${status}↑"
                fi
                if [[ -z "$status" ]]; then
                    status="✓"
                fi
            fi

            printf "%-50s %-30s %s\n" "$wt_path" "$display" "$status"
        done < <(git -C "$MAIN_REPO" worktree list)
        ;;

    # List branch names only (for completion)
    __branches)
        git -C "$MAIN_REPO" worktree list | while IFS= read -r line; do
            wt_path=$(echo "$line" | awk '{print $1}')
            [[ "$wt_path" == "$MAIN_REPO" ]] && continue
            basename "$wt_path" | sed "s/^${REPO_NAME}-//"
        done
        ;;

    # Return main repo path (for shell wrapper)
    __main)
        echo "$MAIN_REPO"
        ;;

    done|rm|remove)
        shift
        force=false
        all=false
        branch=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --force|-f) force=true; shift ;;
                --all)      all=true; shift ;;
                *)          branch="$1"; shift ;;
            esac
        done

        if [[ "$all" == "true" ]]; then
            echo "Removing all worktrees..."
            failed=0
            success=0

            # Get all worktrees except the main one
            while IFS= read -r line; do
                wt_path=$(echo "$line" | awk '{print $1}')

                # Skip main repo
                [[ "$wt_path" == "$MAIN_REPO" ]] && continue

                display_name=$(basename "$wt_path" | sed "s/^${REPO_NAME}-//")

                echo ""
                echo "--- $display_name ---"
                if [[ "$force" == "true" ]]; then
                    if force_remove_worktree "$wt_path" "$display_name"; then
                        ((success++))
                    else
                        ((failed++))
                    fi
                else
                    if remove_worktree "$wt_path" "$display_name"; then
                        ((success++))
                    else
                        ((failed++))
                        echo "Skipping $display_name"
                    fi
                fi
            done < <(git -C "$MAIN_REPO" worktree list)

            echo ""
            echo "Summary: $success removed, $failed skipped"
            # Signal main repo for cd
            echo "__WT_MAIN__:$MAIN_REPO"
        else
            if [[ -z "$branch" ]]; then
                # No name specified - use current worktree path
                worktree_path=$(git rev-parse --show-toplevel 2>/dev/null)
                if [[ -z "$worktree_path" ]] || [[ "$worktree_path" == "$MAIN_REPO" ]]; then
                    echo "Usage: wt done [name] [--force] | wt done --all [--force]" >&2
                    echo "  (run without args from within a worktree)" >&2
                    exit 1
                fi
            else
                worktree_path="$(dirname "$MAIN_REPO")/${REPO_NAME}-$(sanitize_branch "$branch")"
            fi
            if [[ "$force" == "true" ]]; then
                force_remove_worktree "$worktree_path"
            else
                remove_worktree "$worktree_path"
            fi
            # Signal main repo for cd
            echo "__WT_MAIN__:$MAIN_REPO"
        fi
        ;;

    cd|path)
        if [[ -z "${2:-}" ]]; then
            echo "$MAIN_REPO"
        else
            echo "$(dirname "$MAIN_REPO")/${REPO_NAME}-$(sanitize_branch "$2")"
        fi
        ;;

    *)
        print_help
        ;;
esac
